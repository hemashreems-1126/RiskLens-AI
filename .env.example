# Copy this file to .env and fill in your own values.
# Never commit a real .env file.

# --- Groq (the ONLY LLM provider used by RiskLens AI) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Database (docker-compose starts Postgres automatically) ---
DATABASE_URL=postgresql+psycopg2://risklens:risklens@postgres:5432/risklens

# --- LangSmith (fully optional — leave blank / false to skip) ---
LANGSMITH_API_KEY=
LANGCHAIN_TRACING_V2=false

# --- Investigation graph ---
MAX_INVESTIGATION_LOOPS=2

# --- Evaluation cost assumptions (synthetic, for the demo evaluation only) ---
FALSE_POSITIVE_COST=150
FALSE_NEGATIVE_COST=5000

# --- App ---
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# If true, always use mock/offline LLM responses even if GROQ_API_KEY is set.
# Useful for demoing without burning API credits.
FORCE_MOCK_LLM=false
